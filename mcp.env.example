# Required in Railway. Generate a long random value and store it as a secret.
MCP_BEARER_TOKEN=

# Railway sets PORT automatically. These values are production defaults.
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PATH=/mcp

# Structured journal queries use the SQLite files bundled in Dockerfile.mcp.
SQLITE_PATH=/app/data/journal.db
SQLITE_PATH_RWB=/app/data/journal_rwb.db

# Semantic search and research-fit tools.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_EMBED_MODEL=embo-01
CHROMA_TARGET=cloud
CHROMA_COLLECTION=journal_papers
CHROMA_COLLECTION_RWB=journal_papers_rwb
CHROMA_CLOUD_API_KEY=
CHROMA_CLOUD_TENANT=
CHROMA_CLOUD_DATABASE=journals

# Collaboration graph tools. Leave blank to use the service's fallback path.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_URI_RWB=
NEO4J_USER_RWB=
NEO4J_PASSWORD_RWB=
