{
  "spec_version": "mvp-v1",
  "as_of": "2026-08-17",
  "purpose": "期刊知识服务 Agent 的首版产品验收集：真实用户任务判定是否可用，A1-A8 阶段结果用于定位失败原因。",
  "product_scope": {
    "roles": ["editor", "author"],
    "journals": ["ZDXBNXB"],
    "primary_sources": ["sql", "rag", "kg"],
    "status_values": ["EXECUTE", "CLARIFY", "PARTIAL", "REJECT", "ASSUME"],
    "hard_gate_policy": "任何编造论文、作者、机构、统计值或证据错配都直接判定任务失败。"
  },
  "atomic_capabilities": {
    "A1": "条件检索 Retrieve",
    "A2": "语义检索 Semantic Search",
    "A3": "特征提取 Extract",
    "A4": "聚合统计 Aggregate",
    "A5": "趋势计算 Trend",
    "A6": "比较 Compare",
    "A7": "图关系分析 Graph Analysis",
    "A8": "排序与判断 Rank / Assess"
  },
  "manual_rubric": {
    "scale": {
      "0": "错误、缺失或误导",
      "1": "部分满足，但存在明显遗漏或需要人工修正",
      "2": "完整、准确且无需实质修正"
    },
    "dimensions": [
      {"key": "task_completion", "label": "任务完成度"},
      {"key": "grounding", "label": "事实与证据一致性"},
      {"key": "boundary_control", "label": "澄清、假设、降级和拒绝是否正确"},
      {"key": "clarity", "label": "表达是否清晰、结构是否可读"},
      {"key": "actionability", "label": "结果是否支持作者或编辑采取下一步行动"}
    ],
    "pass_rule": "无硬失败，人工总分不低于 8/10，且 grounding 与 boundary_control 均不低于 1。",
    "review_policy": "高风险案例由两名评审独立评分；分歧超过 2 分时由第三人复核。"
  },
