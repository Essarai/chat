# MiniMax（Railway Variables 必填）
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_CHAT_MODEL=MiniMax-Text-01
MINIMAX_EMBED_MODEL=embo-01

# Chroma：默认走 Cloud（推荐）
CHROMA_TARGET=cloud
CHROMA_COLLECTION=journal_papers
CHROMA_CLOUD_API_KEY=your-chroma-cloud-api-key
CHROMA_CLOUD_TENANT=your-tenant-uuid
CHROMA_CLOUD_DATABASE=journals

# 自建 HttpClient 备用（CHROMA_TARGET=http 时使用）
CHROMA_HOST=182.92.0.163
CHROMA_PORT=8000
CHROMA_TOKEN=your-chroma-token

# SQLite — 农生
SQLITE_PATH=./data/journal.db

# Neo4j — 农生（自建）
NEO4J_URI=bolt://182.92.0.163:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ---- 人文社会科学版（物理隔离）----
SQLITE_PATH_RWB=./data/journal_rwb.db
CHROMA_COLLECTION_RWB=journal_papers_rwb
NEO4J_URI_RWB=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER_RWB=your-aura-username
NEO4J_PASSWORD_RWB=your-aura-password

# RAG / 会话
RAG_TOP_K=5
CHAT_MAX_HISTORY=10
ACADEMAX_DOI_BASE=https://www.academax.com/doi

